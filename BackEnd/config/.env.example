# Copy to .env and add your Firebase project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# Mailtrap Email Sending (SMTP)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_EMAIL=your-mailtrap-smtp-username
SMTP_PASSWORD=your-mailtrap-smtp-password
SMTP_FROM_NAME=SpookyMart
SMTP_FROM_EMAIL=no-reply@spookymart.local

# Public application URLs used in verification emails
BACKEND_URL=https://spookymart.onrender.com
FRONTEND_URL=https://spookymart-frontend.onrender.com
